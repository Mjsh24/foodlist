# 이 파일을 .env.local 로 복사한 뒤 값을 채운다 (.env.local은 .gitignore 대상이므로 올리지 않는다)
# 값은 Supabase 대시보드 > Project Settings > API 에서 찾는다
# 주의: Database 메뉴의 연결 문자열(session pooler 등)은 쓰지 않는다

# Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# anon public 키 — 조회에 사용 (브라우저에 포함됨)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# service_role secret 키 — 추가 · 삭제에 사용. RLS를 모두 우회하는 비밀 키
# VITE_ 접두사가 없어서 브라우저에는 전달되지 않고, 개발 서버(npm run dev)에서만 읽는다
# 채팅 · 코드 · 스크린샷에 붙이지 않는다. 비워 두면 추가 · 삭제는 anon 키 + 쓰기 정책(supabase_write_policies.sql)으로 동작한다
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
